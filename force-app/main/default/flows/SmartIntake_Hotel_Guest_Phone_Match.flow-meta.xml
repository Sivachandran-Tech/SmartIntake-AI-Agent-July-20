    <assignments>
        <name>Assign_Phone_Match</name>
        <label>Assign Phone Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>userMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PhoneMatchMessage</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>updatedAnswersJson</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PhoneMatchAnswersJson</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>nextQuestionKey</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>guest_phone_match_choice</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Phone_No_Match</name>
        <label>Assign Phone No Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>updatedAnswersJson</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PhoneNoMatchAnswersJson</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>nextQuestionKey</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>room_type</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Assign_Phone_Submission_Match</name>
        <label>Assign Phone Submission Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>userMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PhoneSubmissionMatchMessage</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>updatedAnswersJson</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>PhoneMatchAnswersJson</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>nextQuestionKey</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>guest_phone_match_choice</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Phone_Contact</name>
        <label>Check Phone Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Phone_No_Match</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Contact</defaultConnectorLabel>
        <rules>
            <name>Phone_Contact_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contact_By_Phone.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Phone_Match</targetReference>
            </connector>
            <label>Phone Contact Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Phone_Submission</name>
        <label>Check Phone Submission</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Contact_By_Phone</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Prior Submission</defaultConnectorLabel>
        <rules>
            <name>Phone_Submission_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Submission_By_Phone.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Phone_Submission_Match</targetReference>
            </connector>
            <label>Phone Submission Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>PhoneMatchAnswersJson</name>
        <dataType>String</dataType>
        <expression>IF(RIGHT({!answersJson}, 1) = &quot;}&quot;, LEFT({!answersJson}, LEN({!answersJson}) - 1) &amp; &quot;,\&quot;guest_phone_match_status\&quot;:\&quot;MATCH_FOUND\&quot;}&quot;, &quot;{\&quot;guest_phone_match_status\&quot;:\&quot;MATCH_FOUND\&quot;}&quot;)</expression>
    </formulas>
    <formulas>
        <name>PhoneMatchMessage</name>
        <dataType>String</dataType>
        <expression>&quot;I found an existing guest record for &quot; &amp; {!Get_Contact_By_Phone.Name} &amp; &quot;. We can use this guest, or you can change the phone number if it is not correct.&quot;</expression>
    </formulas>
    <formulas>
        <name>PhoneNoMatchAnswersJson</name>
        <dataType>String</dataType>
        <expression>IF(RIGHT({!answersJson}, 1) = &quot;}&quot;, LEFT({!answersJson}, LEN({!answersJson}) - 1) &amp; &quot;,\&quot;guest_phone_match_status\&quot;:\&quot;NO_MATCH\&quot;}&quot;, &quot;{\&quot;guest_phone_match_status\&quot;:\&quot;NO_MATCH\&quot;}&quot;)</expression>
    </formulas>
    <formulas>
        <name>PhoneSubmissionMatchMessage</name>
        <dataType>String</dataType>
        <expression>&quot;I found an existing booking for &quot; &amp; IF(ISBLANK({!Get_Submission_By_Phone.Primary_Text__c}), {!Get_Submission_By_Phone.Name}, {!Get_Submission_By_Phone.Primary_Text__c}) &amp; &quot; with this phone number. We can use this guest, or you can change the phone number if it is not correct.&quot;</expression>
    </formulas>
    <interviewLabel>SmartIntake Hotel Guest Phone Match {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SmartIntake Hotel Guest Phone Match</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
