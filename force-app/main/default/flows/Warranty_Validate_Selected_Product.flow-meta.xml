        <name>Check_Asset_Found</name>
        <label>Check Asset Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Invalid_Product</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Matching Asset</defaultConnectorLabel>
        <rules>
            <name>Asset_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Selected_Asset.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
