                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Valid_Product</targetReference>
            </connector>
            <label>Warranty Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>InvalidProductMessage</name>
        <dataType>String</dataType>
        <expression>&quot;I could not find that product under the verified email address. Please choose one of the displayed products or enter a product ID registered to this email.&quot;</expression>
    </formulas>
    <formulas>
